# hr-ai — staging template (hr-docs staging plan §4, step 3).
#
# Reference only, same as hr-backend/.env.staging.example — see that file's
# header for how secrets actually reach the container (SSM + the shared
# entrypoint, never this file). See hr-ai/.env.example for the local-dev
# version and hr-ai/README.md for the S3-credential fallback note.

# --- Database (Sprint 2a) ---
# ONE composed DSN (config.py takes a single string, not decomposed vars) —
# the scoped `hr_ai` role created by hr-backend's migration. Composed once by
# hr-docs/infra/08-derived-secrets.sh and stored whole as its own SSM
# SecureString (see that script's header for why: config.py takes one DSN,
# not decomposed DB_HOST/DB_USER/... vars, so there's nothing to compose at
# container-start without an app-code change).
DATABASE_URL=__SET_VIA_SSM__

# --- Document extraction / object storage (Sprint 1, ADR-0010) ---
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are DELIBERATELY UNSET here — see
# app/storage.py and README.md: when unset, boto3 falls back to the EC2
# instance profile via the default credential chain (no long-lived key on
# the box). AWS_ENDPOINT/AWS_REGION are still explicit either way.
AWS_ENDPOINT=https://s3.eu-west-1.amazonaws.com
AWS_REGION=eu-west-1
AWS_BUCKET=hr-staging-documents-__ACCOUNT_ID__
AWS_USE_PATH_STYLE=false
EXTRACT_IMAGE_DPI=150

# Same value as hr-backend's HR_AI_INTERNAL_TOKEN, different var name here —
# the shared entrypoint maps one SSM value to both names explicitly.
INTERNAL_TOKEN=__SET_VIA_SSM__

# --- Embeddings (Sprint 2a, ADR-0006) — unchanged from dev; the model name/
# dim are non-secret, and HF_HOME is set in hr-ai/Dockerfile (not here). ---
EMBED_MODEL=BGE-M3
EMBED_MODEL_HF=BAAI/bge-m3
EMBED_DIM=1024

# --- LLM (ADR-0015) — NEVER an env var / SSM parameter on staging. The
# Anthropic key stays exactly where it is today: entered once via the
# hr-backend admin "Answer model" screen, Crypt-encrypted in
# answer_model_settings, and passed to hr-ai PER CALL. ---
ANTHROPIC_API_KEY=
